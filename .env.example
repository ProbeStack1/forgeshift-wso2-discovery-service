# Copy to .env and fill in. The .env file is gitignored.

# --- Spring ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/forgeshift_discovery
MONGODB_DATABASE=forgeshift_discovery
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5

# --- WSO2 source ---
WSO2_BASE_URL=https://localhost:9443
WSO2_USERNAME=admin
WSO2_PASSWORD=admin
WSO2_CLIENT_ID=
WSO2_CLIENT_SECRET=
WSO2_TRUST_SELF_SIGNED=true

# --- Discovery tuning ---
FORGESHIFT_DISCOVERY_PARALLEL_DOWNLOADS=4
FORGESHIFT_DISCOVERY_DOWNLOAD_TIMEOUT_SECONDS=60
